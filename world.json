    {
      "id": "onmyo_ryo",
      "name": "陰陽寮",
      "summary": "掌握官方天文、曆法與占卜權力的政府機構，負責維護京城的超自然平衡。",
      "ideology": "以律法與秩序封印混沌。",
      "public_goal": "消除京城內的妖怪威脅，確保皇室安寧。",
      "secret_goal": "尋求將強大的古代怨靈武器化，以在政治博弈中徹底壓制藤原氏。",
      "typical_member_traits": ["傲慢", "精通術語", "階級觀念極重"]
    },
    {
      "id": "imperial_court",
      "name": "平安朝廷",
      "summary": "以天皇為首、藤原氏掌權的最高權力中心，雖表面優雅但內部派系林立。",
      "ideology": "血統決定權力，禮儀即是正義。",
      "public_goal": "維持帝國稅收與領土擴張。",
      "secret_goal": "與北方的荒野天狗達成秘密協議，以妖怪的力量清洗政敵。",
      "typical_member_traits": ["言詞隱晦", "對美感有偏執", "權力至上"]
    },
    {
      "id": "night_parade_remnants",
      "name": "百鬼夜行之遺",
      "summary": "由各路妖怪組成的鬆散聯盟，受強大妖力吸引，試圖在夜晚接管世界。",
      "ideology": "夜晚是我們的領土，恐懼是我們的食糧。",
      "public_goal": "推翻人類對土地的佔領，恢復妖之世。",
      "secret_goal": "尋找被封印的「鬼門關鍵」，釋放足以吞噬京都的終極怨念。",
      "typical_member_traits": ["反覆無常", "殘忍", "遵守妖異契約"]
